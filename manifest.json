{
    "manifest_version": 3,
    "name": "Vuniper Movie Alerts",
    "version": "1.0.0",
    "description": "Get notified when new movies appear on Vuniper.",
    "permissions": [
    "storage",
    "notifications",
    "alarms"
    ],
    "host_permissions": [
        "https://vuniper.com/*",
        "https://img.vuniper.com/*"
    ],
    "background": {
    "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://vuniper.com/movies/*"],
            "js": ["content.js"]
        }

    ],
    "action": {
    "default_title": "Vuniper Movie Alerts",
    "default_popup": "popup.html"
    }
}